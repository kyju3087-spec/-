# ==========================================
# Google Gemini API Key 설정
# ==========================================
# Google AI Studio 또는 Google Cloud 콘솔에서 발급받은 Gemini API 키를 입력하세요.
# 서버 사이드 (Express / Vercel Serverless Function) 환경변수:
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 또는 Vercel / Vite 프론트엔드 환경변수 (필요 시):
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ==========================================
# 앱 실행 설정
# ==========================================
PORT=3000
APP_URL="http://localhost:3000"

